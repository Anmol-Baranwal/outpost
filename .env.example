# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://outpost:outpost@localhost:5432/outpost?schema=public"
DB_CONNECTION_LIMIT=5         # Max DB connections per service

# ─── Auth (NextAuth.js) ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"
# Provider: "credentials" (default), "github", or "oidc"
AUTH_PROVIDER="credentials"
NEXT_PUBLIC_AUTH_PROVIDER="credentials"
# GitHub provider (only needed if AUTH_PROVIDER=github)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_ALLOWED_ORG=""
# ALLOWED_EMAIL_DOMAIN=""
# OIDC provider (only needed if AUTH_PROVIDER=oidc)
# OIDC_ISSUER=""
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""

# ─── AI Pipeline ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""             # Pathfinder embeddings (text-embedding-3-small)
PATHFINDER_URL="http://localhost:3100"
PATHFINDER_MCP_URL=           # Pathfinder knowledge base URL
FALLBACK_DOCS_URL=            # Fallback documentation URL
AI_RESPONSE_MODEL=            # Override AI response model (default: claude-sonnet-4-20250514)
AI_CONFIDENCE_MODEL=          # Override confidence scoring model
AI_CLASSIFIER_MODEL=          # Override ticket classifier model
AI_SENTIMENT_MODEL=           # Override sentiment analysis model

# ─── Shadow Mode ─────────────────────────────────────────────────────────────
# Set to 'true' to run the full AI pipeline but LOG responses instead of posting
# them to Discord/GitHub/Slack/Teams. The gate lives in the AI_RESPONSE queue
# handler, which runs in the WORKER service — so SHADOW_MODE MUST be set on
# outpost-worker to take effect. Setting it only on a bot service does nothing.
# Staging MUST have SHADOW_MODE=true on the worker so it never posts to real
# communities. Production runs SHADOW_MODE=false.
SHADOW_MODE=false

# ─── Discord Bot ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=""              # Bot token used by discord-mcp
DISCORD_BOT_TOKEN=""          # Bot token used by the discord-bot app
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""      # OAuth client secret (dashboard Discord login)
DISCORD_MCP_TOKEN=""          # Shared secret guarding the discord-mcp server
MONITORED_CHANNEL_IDS=""
DISCORD_DIGEST_CHANNEL_ID=    # Channel for onboarding digest posts
# Guild (server) IDs per community — replaces the old single GUILD_ID
DISCORD_GUILD_COPILOTKIT=     # CopilotKit Discord server ID
DISCORD_GUILD_AGUI=           # AG-UI Discord server ID
# Monitored channel IDs per community
DISCORD_CHANNEL_CK_GENERAL=   # CopilotKit #general
DISCORD_CHANNEL_CK_SUPPORT=   # CopilotKit support channel
DISCORD_CHANNEL_AGUI_SUPPORT= # AG-UI support channel
DISCORD_CHANNEL_AGUI_BUILDING= # AG-UI building channel

# ─── Slack Bot ───────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
SLACK_SOCKET_MODE=true

# ─── Teams Bot ───────────────────────────────────────────────────────────────
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=              # optional, for single-tenant apps

# ─── GitHub App ──────────────────────────────────────────────────────────────
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_TEAM_LOGINS=""
# Comma-separated "owner/repo" list the bot is allowed to respond on.
# Defaults to CopilotKit/CopilotKit so it never answers issues on other repos
# it's installed on (e.g. CopilotKit/outpost).
GITHUB_ALLOWED_REPOS="CopilotKit/CopilotKit"

# ─── Linear Sync ─────────────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_TEAM_ID=

# ─── HubSpot CRM ─────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=

# ─── Email (Postmark - managed) ──────────────────────────────────────────────
# POSTMARK_SERVER_TOKEN=""        # Postmark server API token
# POSTMARK_WEBHOOK_TOKEN=""       # Webhook auth token (required in production)

# ─── Email (SMTP - self-hosted alternative) ──────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"

# ─── Worker ──────────────────────────────────────────────────────────────────
HEALTH_PORT=3005              # Health check port — read by BOTH the worker and the
                              # teams-bot, so one value here moves both (it cannot
                              # separate them). Deployed images pin their own:
                              # worker 3005, teams-bot 3003. To run both locally,
                              # override per process rather than relying on this.

# ─── Railway ─────────────────────────────────────────────────────────────────
# Railway auto-deploys from GitHub; no deploy hook needed.
# RAILWAY_TOKEN is only needed for CLI-based deploys (e.g. `railway up`).
# RAILWAY_TOKEN=""
#
# Production runtime vars are managed in the Railway dashboard (per-service),
# not here. They surface locally as RAILWAY_PROD_* when you run
# `railway variables` / pull. Do NOT commit real RAILWAY_PROD_* values.
