GITHUB_CLIENT_SECRET=""

# ─── AI Pipeline ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
PATHFINDER_URL="http://localhost:3100"

# ─── Discord Bot ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
GUILD_ID=""
MONITORED_CHANNEL_IDS=""

# ─── GitHub App ──────────────────────────────────────────────────────────────
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_TEAM_LOGINS=""

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"

# ─── Railway ─────────────────────────────────────────────────────────────────
